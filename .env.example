# ---------------------------------------------------------------------------
# Adnan Tech — server-side environment (Netlify / Vercel functions)
# Copy to .env for local development, or add these as project environment
# variables on the host. NEVER commit real values.
# ---------------------------------------------------------------------------

# Default AI provider. One of: openai | anthropic | gemini | openrouter | ollama | custom
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=
AI_API_KEY=
# Optional: retried automatically when the primary model is missing/unsupported.
AI_FALLBACK_MODEL=

# Optional attribution headers sent with OpenRouter requests (no secrets).
AI_APP_REFERER=https://adnan-tech.netlify.app
AI_APP_TITLE=Adnan Tech

# Optional secondary provider used for vision requests (must be OpenAI-compatible)
AI_VISION_PROVIDER=
AI_VISION_BASE_URL=
AI_VISION_MODEL=
AI_VISION_API_KEY=

# Security: comma-separated allowlist of hosts the AI proxy may contact.
# Leave empty to allow only the built-in provider hosts.
AI_ALLOWED_HOSTS=
# Allow http://localhost / 127.0.0.1 for a local Ollama server.
ALLOW_LOCAL_AI=false

# ---------------------------------------------------------------------------
# Live web research (Gemini + Google Search grounding)
# Server-side only. Never expose GEMINI_API_KEY to the browser and never give
# it a VITE_ or NEXT_PUBLIC_ prefix. It is sent only in the x-goog-api-key
# header from the server function, and is never logged.
# ---------------------------------------------------------------------------
# Create the key in Google AI Studio. Verify the model is available to your
# project before changing GEMINI_MODEL; the app never falls back to an
# unverified model. Leaving the key empty keeps the whole platform working —
# only "Web Research" reports itself as not configured.
GEMINI_API_KEY=
# Model used for grounded answers. Defaults to the latest Flash alias.
GEMINI_MODEL=gemini-flash-latest
# Master switch for the Web Research assistant mode.
GEMINI_WEB_SEARCH_ENABLED=false
# Optional overrides; the built-in Google endpoint is used when empty.
GEMINI_BASE_URL=
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_OUTPUT_TOKENS=3000
# Optional reuse of identical research answers, in seconds. 0 disables caching.
# The cache lives in the function instance memory only and is never persisted.
GEMINI_CACHE_TTL_SECONDS=0

# Network printer diagnostics. Private LAN probes are allowed automatically when
# the app runs locally. Enable explicitly only for a trusted self-hosted setup.
PRINTER_ALLOW_PRIVATE=false
# Public printer probing is disabled by default to avoid acting as a public scanner.
PRINTER_ALLOW_PUBLIC=false
# Let the network probes (port, latency, path, analyzer) target private/LAN
# addresses. Off unless explicitly set to true; intended for a local or trusted
# self-hosted instance only, never for a public deployment.
NET_PROBE_ALLOW_PRIVATE=false

# Request limits
# Per-attempt upstream timeout. The AI layer caps every request — and every retry
# and model fallback — with a 50 s shared budget, because Netlify standard
# functions and vercel.json's maxDuration die at 60 s. Values above 50000 are
# silently clamped to what is left of that budget.
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=2500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Research providers (optional). Without a key, research falls back to
# curated official-site search links that the user can open manually.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Comma separated RSS feeds for Tech Pulse (optional; defaults are built in)
NEWS_FEEDS=

# Supabase. Required for production accounts, RBAC, trials, subscriptions and
# the private workspace. The service role key is ONLY read inside serverless
# functions and must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Development-only local auth. `npm run dev` enables it automatically; set this
# to 0 to use Supabase during development instead. It is always disabled in a
# production build and on Netlify/Lambda, even if this value is 1.
# Accounts are stored in .local-auth/store.json (git-ignored) with scrypt
# password hashes, and sessions are stored as SHA-256 token hashes.
NEXORA_LOCAL_AUTH=
# Optional directory override for the local auth store.
NEXORA_LOCAL_AUTH_DIR=

# Adnan Tech account platform
APP_NAME=Adnan Tech
# Optional verified address for the platform owner. It does NOT grant a role
# automatically. Register and verify the account, then run `npm run owner:promote`.
# Leave this empty until the final production address is chosen.
OWNER_EMAIL=
# Optional verified address used by the explicit platform-admin promotion.
# `OWNER_EMAIL` and `ADMIN_EMAIL` never promote an account during sign-in.
ADMIN_EMAIL=
# Deprecated alias for OWNER_EMAIL; prefer OWNER_EMAIL.
NEXORA_OWNER_EMAIL=
# Default trial length in days (1-365); admins can override it in the database.
NEXORA_TRIAL_DAYS=30
# Public site origin used in verification/recovery redirects (no trailing slash).
NEXORA_SITE_URL=http://localhost:5173
# Required for trial claim hashing. Generate with: openssl rand -hex 32
# Without it, identity hashing is refused and no new trial is granted — the
# account falls back to the standard plan. Changing it later orphans existing
# claims, so set one value per environment and keep it.
NEXORA_HASH_PEPPER=
NEXORA_MAINTENANCE_MODE=false

# Token required by every /api/content/admin method (read, write and delete).
# The endpoint's own listing runs as the service role, so it needs
# SUPABASE_SERVICE_ROLE_KEY and no longer reads SUPABASE_ANON_KEY.
# Generate with: openssl rand -hex 32
CONTENT_ADMIN_TOKEN=

# Structured logs are emitted to the Netlify log stream. Secrets are redacted.
LOG_LEVEL=info
